#version 440
layout(std140, binding = 0) uniform buf {
    mat4 qt_Matrix;
    float qt_Opacity;
    float time;
    float resW; float resH;
    float speed;
    int nColors;
    vec4 c0; vec4 c1; vec4 c2; vec4 c3; vec4 c4; vec4 c5; vec4 c6; vec4 c7;
    float blobSize;
};
//COMMON//
void main() {
    vec2 p = qt_TexCoord0 * vec2(resW, resH);
    float mt = time * speed;
    float radius = max(resW, resH) * blobSize * 0.5;
    seed();
    vec4 acc = vec4(0.0);   // premultiplied, Plus at painter opacity 0.5
    int n = max(4, nColors);
    for (int i = 0; i < 16; i++) {
        if (i >= n) break;
        float cx = 0.2 + rnd() * 0.6, cy = 0.2 + rnd() * 0.6;
        float phaseX = rnd() * 6.28318530718, phaseY = rnd() * 6.28318530718;
        float freqX = 0.3 + rnd() * 0.5, freqY = 0.2 + rnd() * 0.4;
        vec2 c = vec2((cx + sin(mt * freqX + phaseX) * 0.3) * resW,
                      (cy + cos(mt * freqY + phaseY) * 0.3) * resH);
        float d = clamp(distance(p, c) / radius, 0.0, 1.0);
        // gradient to Qt::transparent: rgb AND alpha interpolate toward 0
        vec4 col = colorAt(i);
        float f = 1.0 - d;
        acc += vec4(col.rgb * f * f, f) * 0.5;
    }
    fragColor = clamp(acc, 0.0, 1.0) * qt_Opacity;
}
