#version 440
layout(std140, binding = 0) uniform buf {
    mat4 qt_Matrix;
    float qt_Opacity;
    float time;
    float resW; float resH;
    float speed;
    int nColors;
    vec4 c0; vec4 c1; vec4 c2; vec4 c3; vec4 c4; vec4 c5; vec4 c6; vec4 c7;
    float bands;
    float intensity;
};
//COMMON//
void main() {
    vec2 p = qt_TexCoord0 * vec2(resW, resH);
    float at = time * speed;
    float bh = resH * 0.25;
    float t = p.x / resW;
    seed();
    vec4 acc = vec4(0.0);   // premultiplied, Plus at painter opacity=intensity
    int n = int(bands);
    for (int b = 0; b < 12; b++) {
        if (b >= n) break;
        float phase0 = float(b) * 1.3 + rnd() * 0.5;
        float freq = 0.8 + float(b) * 0.4 + rnd() * 0.3;
        float baseY = resH * 0.25 + (float(b) / float(n)) * resH * 0.4;
        float phase = phase0 + at;
        float surfY = baseY + sin(t * freq * 6.28318530718 + phase) * bh * 0.5
                            + sin(t * freq * 1.7 + phase * 0.7) * bh * 0.3;
        if (p.y >= surfY) {
            // vertical gradient over baseY-bh .. baseY+bh:
            // transparent @0, c @0.4..0.6, transparent @1 (rgb fades with alpha)
            float g = clamp((p.y - (baseY - bh)) / (2.0 * bh), 0.0, 1.0);
            float a = g < 0.4 ? g / 0.4 : (g > 0.6 ? (1.0 - g) / 0.4 : 1.0);
            a = clamp(a, 0.0, 1.0);
            vec4 col = colorAt(b);
            acc += vec4(col.rgb * a * a, a) * intensity;
        }
    }
    fragColor = clamp(acc, 0.0, 1.0) * qt_Opacity;
}
