#version 440
layout(std140, binding = 0) uniform buf {
    mat4 qt_Matrix;
    float qt_Opacity;
    float time;
    float resW; float resH;
    float speed;
    int nColors;
    vec4 c0; vec4 c1; vec4 c2; vec4 c3; vec4 c4; vec4 c5; vec4 c6; vec4 c7;
    float count;
    float minSize; float maxSize;
    float ss;    // size scale (mode-aware, computed QML-side)
    float n;     // effective element count (count scaling)
};
//COMMON//
void main() {
    vec2 p = qt_TexCoord0 * vec2(resW, resH);
    seed();
    vec4 acc = vec4(0.0);   // premultiplied, Plus composition
    int nn = int(n);
    for (int i = 0; i < 256; i++) {
        if (i >= nn) break;
        float ang = rnd() * 6.28318530718;
        float nx = rnd(), ny = rnd();
        float vx = cos(ang), vy = sin(ang);
        float sz = minSize + rnd() * (maxSize - minSize);
        int ci = int(rnd() * 100.0);
        float r = sz * ss;
        vec2 c = vec2(wrapM(nx + vx * speed * 0.06 * time) * resW,
                      wrapM(ny + vy * speed * 0.06 * time) * resH);
        float d = distance(p, c) / r;
        if (d < 1.0) {
            // QRadialGradient: col(a=1) @0 -> col(a=.35) @.5 -> transparent(black) @1
            vec4 col = colorAt(ci);
            float a = d < 0.5 ? mix(1.0, 0.35, d * 2.0) : mix(0.35, 0.0, (d - 0.5) * 2.0);
            vec3 rgb = d < 0.5 ? col.rgb : col.rgb * (1.0 - (d - 0.5) * 2.0);
            acc += vec4(rgb * a, a);
        }
    }
    fragColor = clamp(acc, 0.0, 1.0) * qt_Opacity;
}
