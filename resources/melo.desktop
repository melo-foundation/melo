[Desktop Entry]
Type=Application
Name=melo
Comment=YouTube integrated native desktop music player
Exec=melo %U
Icon=melo
Terminal=false
Categories=AudioVideo;Audio;Player;
StartupWMClass=melo
Keywords=music;audio;player;youtube;stream;playlist;
MimeType=audio/mpeg;audio/mp4;audio/flac;audio/ogg;audio/x-vorbis+ogg;audio/x-opus+ogg;audio/x-wav;audio/webm;x-scheme-handler/melo;
Actions=PlayPause;Next;Previous;

[Desktop Action PlayPause]
Name=Play/Pause
Exec=melo --play-pause

[Desktop Action Next]
Name=Next Track
Exec=melo --next

[Desktop Action Previous]
Name=Previous Track
Exec=melo --previous
