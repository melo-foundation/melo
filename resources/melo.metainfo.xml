    <name>melo-foundation</name>
  </developer>

  <url type="homepage">https://github.com/melo-foundation/melo</url>
  <url type="bugtracker">https://github.com/melo-foundation/melo/issues</url>
  <url type="vcs-browser">https://github.com/melo-foundation/melo</url>

