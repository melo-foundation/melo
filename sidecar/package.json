{
  "name": "melo-sidecar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --minify --external:jsdom --platform=node --format=esm --outfile=dist/melo-sidecar.mjs --banner:js=\"import{createRequire as __meloCreateRequire}from'module';const require=__meloCreateRequire(import.meta.url);\" && esbuild src/plugin-host.ts --bundle --minify --platform=node --format=esm --outfile=dist/melo-plugin-host.mjs",
    "watch": "pnpm build -- --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:drift": "vitest run --config vitest.drift.config.ts"
  },
  "dependencies": {
    "bgutils-js": "^4.0.3",
    "jsdom": "^30.0.1",
    "youtubei.js": "^17.2.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
