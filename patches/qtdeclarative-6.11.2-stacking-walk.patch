+void tst_QQuickWindowContainer::visibilityChangeWithoutWindowContainerDoesNotRequestStackingUpdate()
+{
+    QQuickWindow quickWindow;
+    QQuickItem parentItem(quickWindow.contentItem());
+    QQuickItem childItem(&parentItem);
+
+    auto *windowPrivate = QQuickWindowPrivate::get(&quickWindow);
+    windowPrivate->needsChildWindowStackingOrderUpdate = false;
+    childItem.setVisible(false);
+    QVERIFY(!windowPrivate->needsChildWindowStackingOrderUpdate);
+}
+
+void tst_QQuickWindowContainer::visibilityChangeWithWindowContainerRequestsStackingUpdate()
+{
+    QQuickWindow quickWindow;
+    QQuickItem parentItem(quickWindow.contentItem());
+    QQuickWindowContainer windowContainer(&parentItem);
+    QQuickItem childItem(&parentItem);
+    Q_UNUSED(windowContainer);
+
+    auto *windowPrivate = QQuickWindowPrivate::get(&quickWindow);
+    windowPrivate->needsChildWindowStackingOrderUpdate = false;
+    childItem.setVisible(false);
+    QVERIFY(windowPrivate->needsChildWindowStackingOrderUpdate);
+}
