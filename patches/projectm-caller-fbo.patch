diff --git a/src/libprojectM/ProjectM.cpp b/src/libprojectM/ProjectM.cpp
index 88fa014..cbfb7d7 100644
--- a/src/libprojectM/ProjectM.cpp
+++ b/src/libprojectM/ProjectM.cpp
@@ -98,6 +98,13 @@ void ProjectM::RenderFrame()
         return;
     }
 
+    // melo patch (upstream ToDo): output to the framebuffer bound by the CALLER
+    // instead of hardcoded 0. Required for hosts whose "default" framebuffer is an
+    // FBO (e.g. Qt's QQuickFramebufferObject). Captured here, used for the final
+    // copy below.
+    GLint callerDrawFbo = 0;
+    glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &callerDrawFbo);
+
     // Update FPS and other timer values.
     m_timeKeeper->UpdateTimers();
 
@@ -166,8 +173,8 @@ void ProjectM::RenderFrame()
     // ToDo: Call the to-be-implemented render method in Renderer
     m_activePreset->RenderFrame(audioData, renderContext);
 
-    // ToDo: Allow external apps to provide a custom target framebuffer.
-    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, 0);
+    // melo patch: draw the final output into the caller's framebuffer (was: 0).
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, callerDrawFbo);
     glViewport(0, 0, renderContext.viewportSizeX, renderContext.viewportSizeY);
 
